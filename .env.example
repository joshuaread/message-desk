# Message Desk configuration. Copy to .env and fill in. NEVER commit .env.

# --- Server ---
PORT=8080
# Password for HTTP Basic auth on the whole UI/API (leave blank to disable).
DESK_PASSWORD=
# Where per-job files (uploads, exports, state) are kept.
DATA_DIR=./data
# Timezone for the default service date (most recent Sunday). IANA name.
TZ=America/Chicago

# --- xAI (transcription + SEO). Leave XAI_API_KEY blank to use local fallbacks. ---
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Local transcription fallback (used when XAI_API_KEY is empty or STT fails) ---
# Path to a python interpreter that has faster-whisper installed.
WHISPER_PYTHON=/workspace/venv-whisper/bin/python
WHISPER_MODEL=base.en

# --- WordPress ---
WP_URL=https://citizenschur.ch
# WordPress login name (not the application password label). On citizenschur.ch: josh.
WP_USER=josh
# Users -> Profile -> Application Passwords (spaces are fine, they are stripped).
# On Josh's machines the live password may be provided as CITIZENS_WP_APP_PASSWORD
# instead; if WP_APP_PASSWORD is empty that variable is used automatically.
WP_APP_PASSWORD=
# CITIZENS_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Set to 1 only to allow a plain http:// WordPress (e.g. a local/LAN test site).
WP_ALLOW_HTTP=0
